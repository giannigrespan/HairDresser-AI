# Database (Neon, integrazione Vercel Marketplace)
DATABASE_URL=postgresql://utente:password@host/db?sslmode=require

# Gemini (Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=            # token permanente di un utente di sistema
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=       # App Secret dell'app Meta (verifica firma webhook)
WHATSAPP_VERIFY_TOKEN=     # stringa a tua scelta, da incollare anche nella configurazione webhook di Meta

# Google Calendar (service account): intero JSON su una riga
GOOGLE_SERVICE_ACCOUNT_JSON=

# Protezione del cron di Vercel (stringa casuale lunga)
CRON_SECRET=
